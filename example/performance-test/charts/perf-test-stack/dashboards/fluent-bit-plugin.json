          "expr": "histogram_quantile(0.95, sum(rate(grpc_client_attempt_duration_seconds_bucket{instance=~\"$instance\",job=\"go-out-plugin\"}[2m])) by (le, instance))",
          "legendFormat": "p95 {{instance}}"
